# AI Trading Bot Environment Variables
# Copy this file to .env and fill in your values

# Exchange API Credentials
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_SECRET=your_secret_here

# Optional: Different credentials for testnet
EXCHANGE_TESTNET_API_KEY=your_testnet_api_key
EXCHANGE_TESTNET_SECRET=your_testnet_secret

# Database (optional - defaults to SQLite)
DATABASE_URL=sqlite:///data_cache/trading.db

# Redis (optional - for caching)
REDIS_URL=redis://localhost:6379

# News API Keys (optional)
NEWS_API_KEY=your_news_api_key
FINNHUB_API_KEY=your_finnhub_api_key

# Model Settings
MODEL_DEVICE=auto  # auto, cuda, cpu
